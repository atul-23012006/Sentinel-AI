DATABASE_URL=postgresql+psycopg://sentinelai:sentinelai@localhost:5432/sentinelai
JWT_SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=30
MAX_FAILED_LOGINS=5
TBAC_START_HOUR=9
TBAC_END_HOUR=18

# Admin-gated registration: new accounts start PENDING and can't log in
# until an Administrator approves them. The very first user ever registered
# is auto-activated as a one-time bootstrap. Set to false to go back to
# instant-active registration (e.g. for a quick local demo).
REQUIRE_ADMIN_APPROVAL=true

# Risk engine (Phase 4/5)
RISK_MODEL_PATH=app/risk/artifacts/isolation_forest.joblib
RISK_MONITOR_THRESHOLD=31
RISK_MFA_THRESHOLD=61
RISK_BLOCK_THRESHOLD=81

# Repeated-abuse lockout: after this many step-up challenges/blocks in a
# row, the account is auto-locked pending admin reactivation.
MAX_BLOCKED_REQUESTS=5

# Rapid-fire / burst detection: a deterministic rate-limit, independent of
# the ML risk score - this many resource-access attempts within the window
# forces the next one to BLOCK and raises a RAPID_FIRE_ACCESS alert.
MAX_BURST_REQUESTS=10
BURST_WINDOW_SECONDS=60

# Email step-up verification - used instead of TOTP MFA when a user hasn't
# configured an authenticator app yet. Leave SMTP_HOST unset to fall back to
# logging the code to the backend console (fine for local dev/demo).
EMAIL_OTP_EXPIRE_MINUTES=10
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# AI analyst (Phase 6) - optional. Leave unset to use the built-in template
# explanation instead of calling the Anthropic API.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
